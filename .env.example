# Local development with DATABASE_URL empty is localhost-only, unauthenticated synthetic demo.
# Production NEVER enables demo. All four runtime values below are mandatory there.
DATABASE_URL=
# Generate a cryptographically random secret of at least 32 characters; never commit it.
BETTER_AUTH_SECRET=
# Exact canonical origin, HTTPS in production; no wildcard, subpath, or preview-domain wildcard.
BETTER_AUTH_URL=http://localhost:3000
# Set this to the ID printed by npm run admin:create.
ADMIN_USER_ID=

# Optional Google Calendar sync. Planning still works without these; demo NEVER connects.
# Web application OAuth client; exact redirect is BETTER_AUTH_URL + /api/calendar/callback.
# Generate 32 cryptographically random bytes privately, encoded as standard padded base64.
# Keep the encryption key stable and backed up securely; replacing it requires reconnecting.
# Owner instructions and testing/publishing limitations: docs/GOOGLE_CALENDAR.md
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ENCRYPTION_KEY=

# One-time CLI bootstrap ONLY. E.164 phone including leading +; password 8–128 characters.
# Remove these three from the environment after npm run admin:create.
ADMIN_PHONE=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Hosted images use Netlify Blobs' runtime-provided site identity/token automatically.
# Do not add secrets with NEXT_PUBLIC_ prefixes. All uploads are PUBLIC IMAGES, never invoices.